{
  "name": "@soyalfredo115/at-grid-react",
  "version": "0.1.0",
  "description": "AtGrid — tabla declarativa con superpoderes (orden, filtros, agrupación, export Excel) para React",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./locales/*": "./dist/locales/*",
    "./styles.css": "./dist/at-grid.css"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && shx rm -rf dist/locales && shx cp -r src/locales dist/locales && tailwindcss -i src/styles/tailwind-entry.css -o dist/at-grid.css --minify",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "i18next": "^26.3.4",
    "@formkit/auto-animate": "^0.9.0",
    "lucide-react": "^0.447.0"
  },
  "dependencies": {
    "@soyalfredo115/at-grid-types": "workspace:*"
  },
  "devDependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "i18next": "^26.3.4",
    "lucide-react": "^0.447.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "rimraf": "^6.0.1",
    "shx": "^0.3.4",
    "tailwindcss": "^3.4.14",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
